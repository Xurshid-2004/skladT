rules_version = '2';

// UZ Temiryo'l — Firestore xavfsizlik qoidalari
// Admin panel — faqat role == admin (dasturchi paneli olib tashlangan).
// Rol va zapravka: active_sessions (login paytida yoziladi), access_codes emas.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yordamchi funksiyalar ───────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasActiveSession() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/active_sessions/$(request.auth.uid));
    }

    function session() {
      return get(/databases/$(database)/documents/active_sessions/$(request.auth.uid)).data;
    }

    function getUserCode() {
      return session().code;
    }

    function getUserRole() {
      return session().role;
    }

    function getUserStation() {
      return session().stationId;
    }

    // Admin panel (Statistics, Hisobotlar, Xodim qo'shish, …)
    function isAdminPanel() {
      return getUserRole() == 'admin';
    }

    function isWorker() {
      return getUserRole() == 'worker';
    }

    function sameStation(stationId) {
      return stationId == getUserStation();
    }

    function sessionIdentityUnchanged() {
      return request.resource.data.code == resource.data.code
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function sessionAllowedPatch() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['lastSeen'])
        || keys.hasOnly(['lastSeen', 'stationId', 'nodeId', 'displayName'])
        || keys.hasOnly(['lastSeen', 'stationId', 'nodeId', 'displayName', 'staffVaultFullName'])
        || keys.hasOnly(['staffVaultFullName', 'lastSeen'])
        || keys.hasOnly(['staffVaultFullName'])
        || keys.hasOnly(['displayName', 'lastSeen'])
        || keys.hasOnly(['displayName', 'staffVaultFullName', 'lastSeen']);
    }

    /** Login / layout: kod, rol, zapravka yangilash (createdAt o'zgarmaydi) */
    function sessionLoginRefresh() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let createdAtOk = !('createdAt' in resource.data)
        || request.resource.data.createdAt == resource.data.createdAt;
      return createdAtOk && (
        keys.hasOnly(['code', 'role', 'stationId', 'nodeId', 'displayName', 'lastSeen'])
        || keys.hasOnly(['code', 'role', 'stationId', 'nodeId', 'displayName', 'lastSeen', 'staffVaultFullName'])
        || keys.hasOnly(['code', 'role', 'stationId', 'nodeId', 'displayName', 'lastSeen', 'createdAt'])
        || keys.hasOnly(['code', 'role', 'stationId', 'nodeId', 'displayName', 'lastSeen', 'staffVaultFullName', 'createdAt'])
      );
    }

    function submissionWithin24h() {
      return request.time.toMillis() - resource.data.timestamp < 24 * 60 * 60 * 1000;
    }

    // ─── Faol sessiya (onlayn jadval / presence) ───────────────────────

    match /active_sessions/{sessionId} {
      allow read: if hasActiveSession() && (
        request.auth.uid == sessionId || isAdminPanel()
      );
      allow create: if isAuthenticated() && request.auth.uid == sessionId;
      allow update: if isAuthenticated()
        && request.auth.uid == sessionId
        && (
          (sessionIdentityUnchanged() && sessionAllowedPatch())
          || sessionLoginRefresh()
        );
      allow delete: if isAuthenticated() && request.auth.uid == sessionId;
    }

    // ─── Kirish kodlari (seed / kelajakdagi boshqaruv) ────────────────

    match /access_codes/{code} {
      allow read: if true;
      allow write: if isAdminPanel();
    }

    // ─── Yuborishlar (lokomotiv, korxona, …) ───────────────────────────

    match /submissions/{subId} {
      allow read: if hasActiveSession() && (
        isAdminPanel() || resource.data.stationId == getUserStation()
      );
      allow create: if hasActiveSession() && (
        isAdminPanel() || request.resource.data.stationId == getUserStation()
      );
      allow update: if hasActiveSession() && (
        isAdminPanel()
        || (resource.data.stationId == getUserStation() && submissionWithin24h())
      );
      allow delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Yoqilg'i yozuvlari (Y.PDF / ERJU) ─────────────────────────────

    match /fuelRecords/{docId} {
      allow read: if hasActiveSession() && (
        isAdminPanel() || resource.data.locCode == getUserStation()
      );
      allow create: if hasActiveSession() && (
        isAdminPanel() || request.resource.data.locCode == getUserStation()
      );
      allow update: if hasActiveSession() && isAdminPanel();
      allow delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Xodimlar vault ────────────────────────────────────────────────

    // Ishchi jadvalida tabel → F.I.Sh (useStaffMap); admin — to'liq ro'yxat
    match /staff/{staffId} {
      // Login: staff vault tabel bo'yicha — sessiya hali yozilmagan bo'lishi mumkin
      allow read: if isAuthenticated();
      allow create, update, delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Bloklangan kirish kodlari ─────────────────────────────────────

    match /blocked_codes/{code} {
      allow get: if true;
      allow list: if hasActiveSession() && isAdminPanel();
      allow create, update, delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Chat ──────────────────────────────────────────────────────────

    match /messages/{msgId} {
      allow read: if hasActiveSession();
      allow create: if hasActiveSession();
      allow update: if hasActiveSession()
        && (resource.data.senderCode == getUserCode() || isAdminPanel());
      allow delete: if false;
    }

    // ─── Ruxsatnomalar ─────────────────────────────────────────────────

    match /approvals/{appId} {
      allow read: if hasActiveSession();
      allow create: if hasActiveSession() && isAdminPanel();
      allow update, delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Limitlar, sozlamalar, savollar (ishchi formalar o'qiydi; yozish — admin) ─

    match /limits/{limitId} {
      allow read: if hasActiveSession();
      allow write: if hasActiveSession() && isAdminPanel();
    }

    match /settings/{docId} {
      allow read: if hasActiveSession();
      allow write: if hasActiveSession() && isAdminPanel();
    }

    match /questions/{qId} {
      allow read: if hasActiveSession();
      allow write: if hasActiveSession() && isAdminPanel();
    }

    match /variants/{vId} {
      allow read: if hasActiveSession();
      allow write: if hasActiveSession() && isAdminPanel();
    }

    // ─── Yopilgan kunlar (taqvim) ──────────────────────────────────────

    match /closedDays/{docId} {
      allow read: if hasActiveSession();
      allow create, update, delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Audit va xavfsizlik ───────────────────────────────────────────

    match /audit_logs/{logId} {
      allow read: if hasActiveSession() && isAdminPanel();
      allow create: if hasActiveSession();
      allow update, delete: if false;
    }

    match /security_events/{eventId} {
      allow read: if hasActiveSession() && isAdminPanel();
      allow create: if true;
      allow update, delete: if hasActiveSession() && isAdminPanel();
    }

    // ─── Qurilma qulfi (login oldin ham kerak bo'lishi mumkin) ─────────

    match /device_locks/{deviceId} {
      allow read, write: if true;
    }

    // Boshqa kolleksiyalar — default: rad etish (ochiq emas)
  }
}
